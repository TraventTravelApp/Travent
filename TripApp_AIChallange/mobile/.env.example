# Sentry DSN for mobile error reporting (optional)
# Find under: Sentry project (mobile/React Native) → Settings → Client Keys (DSN)
# Use a DIFFERENT project from the backend so the dashboards stay separated.
# Leave empty to disable Sentry locally; the SDK is a no-op without a DSN.
EXPO_PUBLIC_SENTRY_DSN=

# Override the deployed API Gateway URL for local testing against a custom backend.
# Leave empty to use the production canonical URL hardcoded in src/services/api.ts.
EXPO_PUBLIC_API_BASE_URL=
